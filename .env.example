# Copy to .env and fill in your own values. Never commit real credentials.
# The application does not load .env automatically; export the variables first,
# for example: set -a; . ./.env; set +a

OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_MODEL=your-model-name

# SQLite audit/checkpoint directory (default: runtime)
HARNESS_DATA_DIR=runtime

# Loopback service port (default: 8000)
HARNESS_PORT=8000

# Session idle expiry in days (default: 7); raw evidence retention stays 7 days
HARNESS_SESSION_TTL_DAYS=7

# Maximum characters in one direct user message (default: 1000)
HARNESS_MAX_MESSAGE_CHARS=1000
